+def _configure_package_logging(verbose):
+    """Show the INFO messages of pyCATHY on stdout when ``verbose`` (the default).
+
+    Replaces the quiet/verbose rich console: nothing is changed when the
+    application already configured logging (handlers on the root or package
+    logger), and ``verbose=False`` leaves the logging configuration alone.
